# Public Vite env only — never put seeds, FullAccess keys, OpenRouter, or GATE_I_API_KEY here.
VITE_NETWORK=testnet
VITE_POLICY_CONTRACT_ID=nio-c-policy-857107.testnet
VITE_OWNER_ACCOUNT_ID=nio-c-owner-857107.testnet
VITE_AGENT_ACCOUNT_ID=nio-c-agent-857107.testnet

# Prefer same-origin BFF so privileged API keys stay server-side (vite-plugin-gate-proxy).
# Upstream target: packages/services/.env GATE_I_UPSTREAM or GATE_I_API_KEY + local :8787.
VITE_GATE_I_API_BASE=/api/v1

# Chat 1 authorized 2026-11-10 after Sepolia withdraw receipt PASS (GATE_I.md B2).
VITE_GATE_I_WITHDRAW_PROVEN=true

# Enable only after hosted API + SPA integration verified (trusted TLS + BFF/session).
VITE_GATE_J_ONCHAIN_MANDATE=false
