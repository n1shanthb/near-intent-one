# Gate I hosted API — copy to .env / platform secrets. Never ship to Vite.
NEAR_NETWORK=testnet
NEAR_RPC=https://test.rpc.fastnear.com
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
TIDEPOOL_URL=https://www.usetidepool.tech

GATE_I_HOST=0.0.0.0
GATE_I_PORT=8787
GATE_I_DATA_DIR=/var/lib/nio-gate-i
# Comma-separated origins, or * for local/dev
GATE_I_CORS_ORIGINS=https://your-web-app.example

# Required in production for POST mutations (agent start/stop, etc.)
# This is SERVICE auth — never treat as end-user/owner authentication.
GATE_I_API_KEY=replace-with-long-random

# HMAC secret for owner session tokens (defaults to GATE_I_API_KEY if unset).
# Distinct secret recommended. Browser clients use X-NIO-Owner-Session — not the API key.
# Owner auth scheme: NEP-413 (wallet-selector signMessage / Ledger-compatible).
# Dedicated owner-session HMAC secret (≥32 chars). MUST differ from GATE_I_API_KEY.
# Vercel owner-auth gateway fails closed if this is missing or equals the API key.
NIO_OWNER_AUTH_SECRET=replace-with-long-random-owner-secret

# NEVER enable in public production — harness only
GATE_I_ALLOW_SERVER_OWNER_SIGN=0

# Personal portfolio self-provision (expensive on-chain deploy). Default OFF.
# Prefer action=register for an owner-controlled policy, or operator gate-i-provision.
GATE_I_SELF_PROVISION=0

# Settlement worker — advances MPC_SIGNED → broadcast → settle → reconcile.
# Default OFF. dry-run suppresses eth_sendRawTransaction even when enabled.
GATE_K_SETTLEMENT_WORKER=0
GATE_K_SETTLEMENT_DRY_RUN=1
GATE_K_SETTLEMENT_INTERVAL_MS=30000

# Credential mount (read-only): .near-credentials/testnet/{agent,recon,owners}.json
# Attestor seed is created under GATE_I_DATA_DIR/attestor.seed.json — do not expose.

# ── Gate J — OpenRouter only (server-side; dry-run by default) ─────────────
# Copy this file to packages/services/.env and set OPENROUTER_API_KEY.
# Do NOT put keys in .env.example (committed) or any Vite env.
GATE_J_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GATE_J_RESEARCH_MODEL=google/gemini-2.5-flash
GATE_J_STRATEGIST_MODEL=anthropic/claude-sonnet-4.6
GATE_J_CRITIC_MODEL=openai/gpt-5.2
GATE_J_COPILOT_MODEL=google/gemini-2.5-flash
GATE_J_LLM_TIMEOUT_MS=60000
GATE_J_LLM_MAX_RETRIES=2
GATE_J_LLM_MAX_TOKENS=2048
GATE_J_LLM_MAX_SPEND_USD=1.00

# ── Gate J public demo LIVE AI DRY RUN (POST /v1/gate-j/demo-decide) ────────
# Fail-closed quotas persist under GATE_I_DATA_DIR/gate-j-demo-quota.json
GATE_J_DEMO_ENABLED=1
GATE_J_DEMO_KILL_SWITCH=0
GATE_J_DEMO_PORTFOLIO_ID=i-a-a4e7
GATE_J_DEMO_CLAIMED_OWNER=nio-i-a4e7-a-owner.testnet
GATE_J_DEMO_CLIENT_DAILY_LIMIT=3
GATE_J_DEMO_GLOBAL_DAILY_LIMIT=40
GATE_J_DEMO_MAX_SPEND_USD=2.00
GATE_J_DEMO_MIN_INTERVAL_MS=15000
GATE_J_DEMO_TIMEOUT_MS=90000
GATE_J_DEMO_SINGLE_FLIGHT_TTL_MS=180000

# ── Gate K — AI-directed testnet execution (default OFF / dry-run) ───────────
# Never set GATE_K_ALLOW_SIGN=1 until operator explicitly authorizes first live trade.
GATE_K_ALLOW_SIGN=0
GATE_K_AUTONOMOUS_LOOP=0
GATE_K_EDGE_BUFFER_BPS=20
GATE_K_FEE_BPS=30
GATE_K_ALLOW_MULTI=0
GATE_K_ALLOW_OTHER_PORTFOLIOS=0
GATE_K_COOLDOWN_MS=300000
GATE_K_LOOP_INTERVAL_MS=60000
GATE_K_MAX_FAILURES=3
GATE_K_MAX_AI_SPEND_USD=2.00
